# Copy to server/.env for local development (`npm run dev`). In production, set these
# as environment variables on the host instead. Never commit real keys.
# Get keys from the Stripe Dashboard -> https://dashboard.stripe.com/test/apikeys
# A restricted key (rk_...) with write access to Checkout Sessions works in place of sk_...
STRIPE_SECRET_KEY=sk_test_...
# Get this from the Stripe Dashboard -> https://dashboard.stripe.com/workbench/webhooks
# (or from `stripe listen` when testing locally)
STRIPE_WEBHOOK_SECRET=whsec_...
# The website's origin, used to build the success and cancel URLs
DOMAIN=http://localhost:5173
